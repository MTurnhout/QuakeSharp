<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- a GUI program on Windows, so no console opens before the window (WindowsConsole) -->
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>QuakeSharp</RootNamespace>
    <AssemblyName>QuakeSharp</AssemblyName>
    <!-- Nothing depends on the user's culture, and the Linux builds need no ICU library -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuakeSharp.Core\QuakeSharp.Core.csproj" />
    <ProjectReference Include="..\QuakeSharp.Platform.Sdl\QuakeSharp.Platform.Sdl.csproj" />
    <ProjectReference Include="..\QuakeSharp.Render.Vulkan\QuakeSharp.Render.Vulkan.csproj" />
  </ItemGroup>

</Project>
