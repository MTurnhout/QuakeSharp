<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- What ships is trimmed or compiled with NativeAOT (design.md §4): their analyzers check every build. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
