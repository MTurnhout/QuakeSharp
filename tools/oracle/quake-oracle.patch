diff --git a/world.c b/world.c
index e1acfea..b2e7850 100644
--- a/world.c
+++ b/world.c
@@ -238,6 +238,34 @@ areanode_t *SV_CreateAreaNode (int depth, vec3_t mins, vec3_t maxs)
 	return anode;
 }
 
+#ifdef ORACLE
+/*
+===============
+Oracle_AreaLinks
+
+The trace's W line (trace.c): every area node's trigger list, then its solid list, as edict numbers in their order,
+each list ended by -1. Returns how many numbers it wrote.
+===============
+*/
+int Oracle_AreaLinks (int *out, int max)
+{
+	int		i, s, n;
+	link_t	*list, *l;
+
+	n = 0;
+	for (i = 0; i < sv_numareanodes; i++)
+		for (s = 0; s < 2; s++)
+		{
+			list = s ? &sv_areanodes[i].solid_edicts : &sv_areanodes[i].trigger_edicts;
+			for (l = list->next; l != list && n < max; l = l->next)
+				out[n++] = NUM_FOR_EDICT (EDICT_FROM_AREA (l));
+			if (n < max)
+				out[n++] = -1;
+		}
+	return n;
+}
+#endif
+
