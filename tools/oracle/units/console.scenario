# The console's text (console.c) and the keys (keys.c): printing, wrapping, resizing, typing, history, completion,
# bindings and the message line.
time 1.25
dump

# printing before the video is set up: 38 columns
print hello\n
print a line that is long enough to wrap at the console's width of thirty-eight\n
print averyveryveryverylongwordthatcannotwrapanywhereatallbecauseithasnospaces\n
print no newline,
print  continued\n
print carriage\rreturn\n
print \x01talk colored\n
print \x02colored\n
print high\xe9 bytes\xff end\n
print tab\x09and\x0bvertical\n
time 2.5
print \n\nblank lines above\n
dump

# resizing reflows the text
vid 640 480
dump
vid 320 200
dump
vid 512 384
print after resizing to 62 columns\n
dump

