# bindings, as the game sees keys
text bind w +forward\n
text bind SPACE +jump\n
text bind k "echo kick ; echo twice"\n
text bind PGUP "echo page up"\n
text bind NOSUCHKEY foo\n
text bind w\n
text bind x\n
text bind\n
text bind SEMICOLON "echo semi"\n
text bind mouse1 +attack\n
text unbind x\n
text unbind bogus\n
execute
dest 0
key 119 1
key 119 1
key 119 0
key 32 1
key 32 0
key 107 1
key 107 0
key 150 1
key 150 0
key 59 1
